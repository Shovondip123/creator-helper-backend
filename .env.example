PORT=3000
DEMO_MODE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
USD_BDT_RATE=120

# Firebase Admin credential: use ONE of the following approaches.
# 1) Path relative to backend/: FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# 2) JSON in environment: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# 3) Google Application Default Credentials: leave both blank and configure ADC on the server.
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Leave ADMIN_KEY blank for automatic first-start generation.
# The generated secret is saved to backend/admin-key.txt.
ADMIN_KEY=

# Payment receiving details
PAYMENT_BKASH=
PAYMENT_NAGAD=
PAYMENT_SKRILL=
PAYMENT_BANK=
PAYMENT_BANK_SWIFT=
